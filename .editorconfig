root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
# Compose の関数は大文字で始める（Android の公式の規約）
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.md]
# 行末の 2 つの空白を改行に使うことがある
trim_trailing_whitespace = false

[*.{yml,yaml,toml}]
indent_size = 2
