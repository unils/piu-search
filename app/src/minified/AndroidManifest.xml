<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        debuggable でない版のプロセスを、shell（Macrobenchmark・Baseline Profile の生成）から記録できるようにする。
        API 29 から。配布する release には付けない
    -->
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>
