<!--
    Android 8.x。requireFlags がないので、クラウドと端末間の転送を区別できない。
    クラウドに送らないことを優先し、すべて外す
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
</full-backup-content>
