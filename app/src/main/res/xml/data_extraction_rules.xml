<!--
    Android 12 以降。クラウドには何も送らず、端末間転送は Android 9〜11 と同じ DB と設定だけを許す。
    索引の DB（index.db とその付属のファイル）は Android 9〜11 と同じく外す
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="index.db" />
        <exclude domain="database" path="index.db-wal" />
        <exclude domain="database" path="index.db-shm" />
        <exclude domain="database" path="index.db-journal" />
    </device-transfer>
</data-extraction-rules>
