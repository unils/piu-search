<!--
     geo: を開けるアプリ（ジャンル: 地図）。CATEGORY_APP_MAPS は、AOSP のアプリと同じく起動の入口の intent filter に書く。
     既定の名前を英語にし、日本語を values-ja に置く（多くの海外のアプリと同じ形）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- データを持たないので、バックアップを切るだけで足り、Android 12 からの細かい規則（dataExtractionRules）は要らない -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/test_app_icon"
        android:label="@string/app_name"
        tools:ignore="DataExtractionRules">
        <activity
            android:name="jp.piu.search.testapp.common.TestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
    </application>

</manifest>
