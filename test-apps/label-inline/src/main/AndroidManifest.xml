<!--
     表示名をマニフェストに直に書いたアプリ（資源でない名前）。別の言語の名前は正常な不在で、欠けにならない
     （architecture.md の「失敗の分け方」）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- データを持たないので、バックアップを切るだけで足り、Android 12 からの細かい規則（dataExtractionRules）は要らない -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/test_app_icon"
        android:label="直書きテスト"
        tools:ignore="DataExtractionRules,HardcodedText">
        <activity
            android:name="jp.piu.search.testapp.common.TestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
