<!--
     LAUNCHER の Activity を持たないアプリ。geo: の intent filter は持つので、ジャンルの問い合わせには出るが、
     起動できるアプリの一覧には出てはいけない
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- データを持たないので、バックアップを切るだけで足り、Android 12 からの細かい規則（dataExtractionRules）は要らない -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/test_app_icon"
        android:label="@string/app_name"
        tools:ignore="DataExtractionRules">
        <activity
            android:name="jp.piu.search.testapp.common.TestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
    </application>

</manifest>
