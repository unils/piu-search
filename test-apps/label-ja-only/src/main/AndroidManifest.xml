<!--
     表示名が values-ja/ にだけあり、既定の values/ にないアプリ（architecture.md の「失敗の分け方」）。
     英語の名前を読むと Resources.NotFoundException になり、決定的な欠け（LABEL）になる。日本語の名前と表示名では引ける。
     Robolectric の偽の資源は本物と同じ条件でこの例外を投げないので、計器テスト（MaterialIssueInstrumentedTest）で確かめる
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- データを持たないので、バックアップを切るだけで足り、Android 12 からの細かい規則（dataExtractionRules）は要らない -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/test_app_icon"
        android:label="@string/app_name"
        tools:ignore="DataExtractionRules">
        <activity
            android:name="jp.piu.search.testapp.common.TestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
