<!--
     ApplicationInfo.category（appCategory）だけでジャンル（ゲーム）が決まるアプリ。
     名前に「ゲーム」を入れず、名前の照合と区別できるようにする
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- データを持たないので、バックアップを切るだけで足り、Android 12 からの細かい規則（dataExtractionRules）は要らない -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/test_app_icon"
        android:label="@string/app_name"
        tools:ignore="DataExtractionRules"
        android:appCategory="game">
        <activity
            android:name="jp.piu.search.testapp.common.TestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
